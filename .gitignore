# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
# ...but not the model-build subpackage of campfire-etc
!etc/campfire_etc/build/

# Jupyter
.ipynb_checkpoints/
*.ipynb
!python/examples/*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# CAMPFIRE Secrets - DO NOT COMMIT
campfire/config.toml
scripts/config.toml
.env
.env.*
!.env.example

# Data directories (large files)
data/raw/
data/preprocessed/
data/extractions/

# Pipeline data (LARGE - raw JWST data and products)
pipeline/data/
pipeline/products/
pipeline/observations.toml
pipeline/fields.toml
pipeline/templates/*.pickle
pipeline/templates/pictureframe/

# setuptools-scm generated version file (regenerated on every install)
pipeline/campfire_pipeline/_version.py

# Generated map tiles (uploaded to R2)
pipeline/tiles/

# CRDS cache
crds/

# Logs
*.log
logs/

# Temporary files
*.tmp
.cache/

# Claude Code per-user state (shared settings and skills under .claude/ are tracked)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Periodic /campfire-review output (local triage artifacts)
reports/

# install.py state (per-machine answers; its log is covered by *.log above)
.campfire-install.json

# pytest
.pytest_cache/

# Scale DB dumps live outside the repo; belt and braces if someone points the script here
scripts/scale_db/*.dump
scripts/scale_db/*.sha256
scripts/scale_db/LATEST
