# CAMPFIRE web portal environment — copy to .env.local and fill in.
# .env.local is gitignored; never commit real credentials.
# install.py (repo root) can scaffold this copy for you.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=       # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=      # Supabase service role key (server-only)
SUPABASE_JWT_SECRET=            # Project JWT secret (Dashboard → Settings → API → JWT). Verifies
                                # session cookies locally (lib/auth/supabase-jwt.ts) and signs
                                # deploy-CLI tokens. Local CLI stack:
                                # super-secret-jwt-token-with-at-least-32-characters-long
                                # Unset → identity falls back to a GoTrue round trip per request.
JWT_SECRET=                     # HS256 secret for campfire-issued API access tokens (any 32+ random bytes)

# --- Object storage: "data" bucket (spectra, photometry, ...) ---
# Neutral S3_* names are canonical; R2_* names are accepted as aliases.
S3_ACCESS_KEY_ID=               # access key   (alias: R2_ACCESS_KEY_ID)
S3_SECRET_ACCESS_KEY=           # secret key   (alias: R2_SECRET_ACCESS_KEY)
S3_BUCKET_NAME=                 # bucket name  (alias: R2_BUCKET_NAME)
S3_ACCOUNT_ID=                  # R2 account (derives the endpoint; alias: R2_ACCOUNT_ID)
# S3_ENDPOINT=                  # explicit endpoint URL (set this for OSN/MinIO instead of S3_ACCOUNT_ID)
# S3_REGION=                    # SigV4 region (default "auto"; set a real region for non-R2 backends)
# S3_FORCE_PATH_STYLE=          # "true" for path-style addressing (some non-AWS S3 stores)
# S3_PUBLIC_URL_BASE=           # public URL base for served assets (alias: R2_PUBLIC_URL)

# --- Object storage: map tiles bucket ---
# Same keys with a TILES_ infix; tiles stay on R2 (CDN edge cache) even when
# the data bucket points elsewhere.
# S3_TILES_ACCESS_KEY_ID=
# S3_TILES_SECRET_ACCESS_KEY=
# S3_TILES_BUCKET_NAME=
# S3_TILES_ACCOUNT_ID=
