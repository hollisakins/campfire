# CAMPFIRE self-hosted stack — compose interpolation variables.
# Copy to ops/.env (mode 600, gitignored). Server-only secrets for the web
# container go in ops/web.env (see the bottom of this file). Runbook: README.md.
#
# Generate random values with: openssl rand -hex 32

# ---- Hosts -------------------------------------------------------------------
WEB_HOST=dev.campfire.hollisakins.com          # portal hostname Caddy serves (prod: campfire.hollisakins.com)
API_HOST=api.campfire.hollisakins.com          # Supabase API hostname (browser-facing /auth/v1, /rest/v1)
SITE_URL=https://dev.campfire.hollisakins.com  # GoTrue site url: default redirect target in auth emails
ADDITIONAL_REDIRECT_URLS=https://campfire.hollisakins.com/**,https://dev.campfire.hollisakins.com/**,http://localhost:3000/**  # GoTrue allow-list (copy the hosted Dashboard → Auth → URL Configuration list)
API_EXTERNAL_URL=https://api.campfire.hollisakins.com/auth/v1  # GoTrue's public url; also the JWT issuer
SUPABASE_PUBLIC_URL=https://api.campfire.hollisakins.com       # Studio's idea of the API url

# ---- Data root ---------------------------------------------------------------
CAMPFIRE_DATA_ROOT=/srv/campfire               # the attached volume: db/, backups/, certs/, auth-templates/

# ---- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=                             # superuser + service-role password (roles.sql on first init)
POSTGRES_DB=postgres                           # keep: the hosted dump restores into `postgres`
POSTGRES_PORT=5432                             # host port on 127.0.0.1 (psql, supabase db push)
PG_SHARED_BUFFERS=6GB                          # ~1/4 of RAM (m3.medium: 30 GB)
PG_EFFECTIVE_CACHE_SIZE=20GB                   # ~2/3 of RAM
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=120                         # PostgREST pool + GoTrue + meta + psql headroom
PG_LOG_MIN_DURATION_MS=1000                    # log statements slower than this (ms)

# ---- JWT / API keys ----------------------------------------------------------
# Copy JWT_SECRET from the hosted project (Dashboard → Settings → API → JWT
# Settings). With the same secret the existing ANON_KEY / SERVICE_ROLE_KEY,
# browser sessions and `campfire login` refresh tokens all stay valid.
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=                                      # hosted anon key (HS256 JWT, role=anon)
SERVICE_ROLE_KEY=                              # hosted service_role key

# ---- Studio / pg-meta --------------------------------------------------------
DASHBOARD_USERNAME=campfire                    # Kong basic auth in front of Studio (127.0.0.1:8000 only)
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=                            # 32+ chars; pg-meta encrypts saved connection strings with it

# ---- PostgREST ---------------------------------------------------------------
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000                         # copy Dashboard → Settings → API → Max rows
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_POOL=20

# ---- GoTrue (auth) -----------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false                 # confirmations stay on (supabase/config.toml enable_confirmations)
PASSWORD_MIN_LENGTH=6
# Rate limits, per hour (supabase/config.toml [auth.rate_limit] mirrors the
# LOCAL dev stack; copy the hosted Dashboard → Auth → Rate Limits values).
# config.toml has email_sent = 2, which would starve invites in production.
RATE_LIMIT_EMAIL_SENT=30
RATE_LIMIT_SMS_SENT=30
RATE_LIMIT_ANONYMOUS_USERS=30
RATE_LIMIT_TOKEN_REFRESH=150                   # per 5 min
RATE_LIMIT_SIGN_IN_SIGN_UPS=30                 # per 5 min
RATE_LIMIT_TOKEN_VERIFICATIONS=30              # per 5 min
SMTP_MAX_FREQUENCY=1s

# Resend SMTP (https://resend.com/docs/send-with-smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=                                     # Resend API key
SMTP_ADMIN_EMAIL=noreply@campfire.hollisakins.com   # From address; must be on a Resend-verified domain
SMTP_SENDER_NAME=CAMPFIRE

# Email templates exported from Dashboard → Auth → Email Templates into
# $CAMPFIRE_DATA_ROOT/auth-templates/*.html; Caddy serves that directory at
# https://$API_HOST/templates/. Leave empty for GoTrue's defaults.
MAILER_TEMPLATES_INVITE=https://api.campfire.hollisakins.com/templates/invite.html
MAILER_TEMPLATES_CONFIRMATION=https://api.campfire.hollisakins.com/templates/confirmation.html
MAILER_TEMPLATES_RECOVERY=https://api.campfire.hollisakins.com/templates/recovery.html
MAILER_TEMPLATES_MAGIC_LINK=https://api.campfire.hollisakins.com/templates/magic_link.html
MAILER_TEMPLATES_EMAIL_CHANGE=https://api.campfire.hollisakins.com/templates/email_change.html
MAILER_SUBJECTS_INVITE=You have been invited to CAMPFIRE
MAILER_SUBJECTS_CONFIRMATION=Confirm your CAMPFIRE signup
MAILER_SUBJECTS_RECOVERY=Reset your CAMPFIRE password
MAILER_SUBJECTS_MAGIC_LINK=Your CAMPFIRE sign-in link
MAILER_SUBJECTS_EMAIL_CHANGE=Confirm your new CAMPFIRE email

# ---- Web image ---------------------------------------------------------------
WEB_IMAGE=ghcr.io/hollisakins/campfire-web
WEB_TAG=main                                   # deploy.sh rewrites this line with the deployed commit sha
WEB_PORT=3000                                  # host port on 127.0.0.1 (health checks, cron)
KONG_HTTP_PORT=8000                            # host port on 127.0.0.1 (Studio over SSH tunnel)

# ---- Host-side scripts (systemd units read this file too) --------------------
REPO_DIR=/srv/campfire/repo                    # git checkout deploy.sh updates for migrations
SUPABASE_CLI_VERSION=2.120.0                   # npx -y supabase@<version> db push
CRON_SECRET=                                   # same value as in web.env; cron-sync-snapshot.sh sends it
HEALTHCHECK_PING_URL=                          # healthchecks.io-style ping url for backup.sh (optional)
HEALTHCHECK_PING_URL_SNAPSHOT=                 # ping url for cron-sync-snapshot.sh (optional)
HEALTHCHECK_PING_URL_RESTORE=                  # ping url for restore-check.sh (optional)
# Backup target on OSN (S3-compatible). rclone is configured from these.
BACKUP_S3_ENDPOINT=https://<osn-endpoint>
BACKUP_S3_BUCKET=                              # private bucket; dumps go under $BACKUP_S3_PREFIX/{daily,monthly}/
BACKUP_S3_PREFIX=db-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_LOCAL=3                            # local dumps kept in $CAMPFIRE_DATA_ROOT/backups

# ==============================================================================
# ops/web.env — server-only environment of the web container (env_file).
# Same variable names as web/.env.example; the NEXT_PUBLIC_* values are BAKED
# INTO THE IMAGE by web/Dockerfile and must be passed as build args instead.
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://api.campfire.hollisakins.com   # build arg, listed for reference
# SUPABASE_SERVICE_ROLE_KEY=        # = SERVICE_ROLE_KEY above
# SUPABASE_JWT_SECRET=              # = JWT_SECRET above (verifies session cookies locally)
# JWT_SECRET=                       # campfire-issued API access tokens (independent secret)
# CRON_SECRET=                      # bearer the sync-snapshot route expects
# WORKER_JWT_SECRET=                # shared with the Cloudflare download Worker
# CDN_FRONT_URL=https://campfire-download.hollisakins.com
# RESEND_API_KEY=                   # admin notification emails (lib/email/resend.ts)
# ADMIN_NOTIFICATION_EMAIL=
# S3_ENDPOINT= S3_REGION= S3_FORCE_PATH_STYLE= S3_BUCKET_NAME= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=
# S3_OSN_BACKEND= S3_OSN_ENDPOINT= S3_OSN_REGION= S3_OSN_FORCE_PATH_STYLE= S3_OSN_BUCKET_NAME=
# S3_OSN_ACCESS_KEY_ID= S3_OSN_SECRET_ACCESS_KEY= S3_OSN_RW_ACCESS_KEY_ID= S3_OSN_RW_SECRET_ACCESS_KEY=
# OSN_READ_ENABLED=true
# S3_TILES_ACCESS_KEY_ID= S3_TILES_SECRET_ACCESS_KEY= S3_TILES_BUCKET_NAME= S3_TILES_ACCOUNT_ID=
# S3_TILES_PUBLIC_URL_BASE=https://campfire-tiles.hollisakins.com
# RETAIN_MODE=log
