# CAMPFIRE reverse proxy (ops/README.md).
#
# TLS: Cloudflare origin certificate + key at $CAMPFIRE_DATA_ROOT/certs
# (origin.pem / origin.key), Cloudflare in "Full (strict)" mode in front. The
# Let's Encrypt alternative (DNS challenge via the Cloudflare module) needs a
# custom Caddy build; see the README before switching.
#
# Behind Cloudflare the connecting peer is always an edge node, so the
# Cloudflare ranges are trusted proxies and {client_ip} / X-Forwarded-For
# resolve to the visitor. Update the list from
# https://www.cloudflare.com/ips/ if it ever changes.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(common) {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip
	header -Server
}

# Web portal → Next.js
{$WEB_HOST} {
	import common
	reverse_proxy web:3000 {
		header_up X-Real-IP {client_ip}
		# Streaming routes (cutouts, FITS) may take up to 60 s.
		transport http {
			response_header_timeout 120s
		}
	}
}

# Supabase API → Kong. Only the two paths supabase-js uses are exposed; the
# Studio catch-all and /pg stay on 127.0.0.1:8000 (SSH tunnel).
{$API_HOST} {
	import common

	@api path /auth/v1/* /rest/v1/*
	handle @api {
		reverse_proxy kong:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# GoTrue email templates (GOTRUE_MAILER_TEMPLATES_* point here).
	handle_path /templates/* {
		root * /srv/auth-templates
		file_server
	}

	handle {
		respond 404
	}
}
